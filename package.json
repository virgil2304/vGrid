{
  "name": "vgrid",
  "version": "1.0.541",
  "description": "Virgil's Grid (vGrid): a zero-dependency JavaScript data grid for the browser, React, and Vue.",
  "license": "MIT",
  "homepage": "https://github.com/virgil2304/vGrid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virgil2304/vGrid.git"
  },
  "bugs": {
    "url": "https://github.com/virgil2304/vGrid/issues"
  },
  "keywords": [
    "vgrid",
    "virgils-grid",
    "grid",
    "data-grid",
    "datagrid",
    "table",
    "javascript",
    "react",
    "vue",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/vgrid.cjs",
  "module": "./src/vgrid.js",
  "types": "./types/index.d.ts",
  "unpkg": "./dist/vgrid.min.js",
  "jsdelivr": "./dist/vgrid.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./src/vgrid.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/vgrid.cjs"
      },
      "default": "./src/vgrid.js"
    },
    "./style.css": {
      "types": "./types/style.d.ts",
      "default": "./src/vgrid.css"
    },
    "./react": {
      "import": {
        "types": "./types/react.d.ts",
        "default": "./integrations/react.js"
      },
      "require": {
        "types": "./types/react.d.cts",
        "default": "./integrations/react.cjs"
      },
      "default": "./integrations/react.js"
    },
    "./vue": {
      "import": {
        "types": "./types/vue.d.ts",
        "default": "./integrations/vue.js"
      },
      "require": {
        "types": "./types/vue.d.cts",
        "default": "./integrations/vue.cjs"
      },
      "default": "./integrations/vue.js"
    },
    "./browser": {
      "import": {
        "types": "./types/browser.d.ts",
        "default": "./integrations/browser.js"
      },
      "require": {
        "types": "./types/browser.d.cts",
        "default": "./integrations/browser.cjs"
      },
      "default": "./integrations/browser.js"
    },
    "./browser/style.css": {
      "types": "./types/style.d.ts",
      "default": "./dist/vgrid.css"
    },
    "./dist/vgrid.css": {
      "types": "./types/style.d.ts",
      "default": "./dist/vgrid.css"
    },
    "./dist/vgrid.min.css": {
      "types": "./types/style.d.ts",
      "default": "./dist/vgrid.min.css"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "integrations/",
    "types/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "./integrations/browser.js",
    "./integrations/browser.cjs",
    "./dist/*.js"
  ],
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
