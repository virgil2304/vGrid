{
  "name": "vgrid",
  "version": "1.0.0",
  "description": "A dependency-light JavaScript data grid for the browser, React, and Vue.",
  "type": "module",
  "main": "./src/vgrid.js",
  "module": "./src/vgrid.js",
  "exports": {
    ".": {
      "import": "./src/vgrid.js",
      "default": "./src/vgrid.js"
    },
    "./style.css": "./src/vgrid.css",
    "./react": "./integrations/react.js",
    "./vue": "./integrations/vue.js",
    "./browser": "./dist/vgrid.js",
    "./browser/style.css": "./dist/vgrid.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "integrations/",
    "dist/",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "build": "npm run build:browser && npm run build:css",
    "build:browser": "esbuild src/vgrid.js --bundle --format=iife --global-name=vGridPackage --footer:js=\"globalThis.vGrid = vGridPackage.vGrid\" --outfile=dist/vgrid.js && esbuild dist/vgrid.js --minify --banner:js=\"/* vGrid */\" --sourcemap --outfile=dist/vgrid.min.js",
    "build:css": "esbuild src/vgrid.css --outfile=dist/vgrid.css && esbuild src/vgrid.css --minify --banner:css=\"/* vGrid */\" --sourcemap --outfile=dist/vgrid.min.css"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
